---
import { CustomAnalysisForm, MCDADashboard } from "./react/MCDAAnalysis";
import ApiClient from "../lib/api-client/ApiClient";
import type {
  MCDAGoal,
  McdaKeyInsightCard,
  McdaResults,
  OutrankingGraphData,
} from "../types";
import {
  buildMcdaKeyInsights,
  buildOutrankingGraphData,
  formatDateWithTime,
  MCDA_PERSPECTIVES,
  resolveMcdaPerspectiveLabel,
} from "../lib/helpers";

const { perspective, name, jobId } = Astro.props;
const api = new ApiClient(Astro.request);

let formattedDate: string | null = null;
let goals: MCDAGoal[] = [];
let mcdaResults: McdaResults | undefined = undefined;
let outrankingGraphData: OutrankingGraphData | undefined = undefined;
let mcdaKeyInsights: McdaKeyInsightCard[] = [];
let resultsTitle = name ?? "MCDA Analysis Results";
let perspectives = MCDA_PERSPECTIVES;

try {
  const latestRun = jobId
    ? await api.getJobRunById(jobId)
    : await api.getLatestJobRun(`mcda_analysis_qualitative_${perspective}`);

  if (latestRun) {
    perspectives = latestRun.input_data?.perspectives?.labels ?? {
      user_personalized: "User Personalized",
    };
    console.log("perspectives from API", perspectives);
    resultsTitle = resolveMcdaPerspectiveLabel(perspective, perspectives);
    formattedDate = formatDateWithTime(latestRun.created_at);
    goals = latestRun.input_data?.goals || [];
    mcdaResults = latestRun.output_data?.mcda_results;
    outrankingGraphData = buildOutrankingGraphData(mcdaResults);
    mcdaKeyInsights = buildMcdaKeyInsights(mcdaResults);
  }
} catch (error) {
  console.error("Error fetching job run data:", error);
}
---

<div id="results" class="mx-auto px-1 space-y-4">
  <h2 class="text-2xl font-bold text-gray-900 mb-3 text-center">
    {resultsTitle}
    {
      name && (
        <>
          <br />
          {name}
        </>
      )
    }
  </h2>

  {
    formattedDate && (
      <p class="text-sm text-gray-500 text-center">
        Results were updated on {formattedDate}
      </p>
    )
  }
  <MCDADashboard
    perspectives={perspectives}
    selectedPerspective={perspective}
    goals={goals}
    mcdaResults={mcdaResults}
    outrankingGraphData={outrankingGraphData}
    mcdaKeyInsights={mcdaKeyInsights}
    client:load
  />
</div>
