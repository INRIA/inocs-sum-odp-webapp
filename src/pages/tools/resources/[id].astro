---
import Layout from "../../../layouts/Layout.astro";
import ApiClient from "../../../lib/api-client/ApiClient";
import {
  ArrowLeftIcon,
  ArrowTopRightOnSquareIcon,
} from "@heroicons/react/24/outline";
import { Badge, InnerHtml, RButton } from "../../../components/react/ui";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/tools/resources");
}

const api = new ApiClient(Astro.request);
const resource = await api.getItemById(Number(id));

if (!resource) {
  return Astro.redirect("/tools/resources");
}

const formattedDate = resource.created_at
  ? new Date(resource.created_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/tools/resources" },
    { label: resource.category.name },
    { label: resource.name },
  ]}
  backHref="/tools/resources"
>
  <main class="mx-auto px-4 py-12">
    <article class="lg:p-8 flex flex-col gap-4">
      <h1>{resource.name}</h1>
      {
        formattedDate && (
          <p class="mt-2 text-sm text-gray-500">Published on {formattedDate}</p>
        )
      }
      <div class="flex flex-row gap-4 justify-between items-center">
        {
          resource.item_tag && resource.item_tag.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {resource.item_tag.map((tag: any) => (
                <Badge
                  key={tag.id}
                  color="none"
                  size="md"
                  className="text-dark"
                  style={{ backgroundColor: tag.tags.color }}
                >
                  {tag.tags.name}
                </Badge>
              ))}
            </div>
          )
        }

        {
          resource.url && (
            <div class="flex items-center ">
              <RButton
                variant="primary"
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="inline-flex items-center gap-1">
                  Open Resource
                  <ArrowTopRightOnSquareIcon className="ml-2 h-4 w-4" />
                </span>
              </RButton>
            </div>
          )
        }
      </div>

      <div class="space-y-6 border-t border-gray-200 pt-8">
        {
          resource.project && (
            <div>
              <h3 class="text-sm font-medium text-gray-500">
                Related Policy Measure
              </h3>
              <div class="mt-2">
                <Badge color="light" size="md">
                  {resource.project.name}
                </Badge>
              </div>
            </div>
          )
        }

        {
          resource.living_lab && (
            <div>
              <h3 class="text-sm font-medium text-gray-500">Living Lab</h3>
              <div class="mt-2">
                <Badge color="secondary" size="md">
                  {resource.living_lab.name}
                  {resource.living_lab.country &&
                    ` - ${resource.living_lab.country}`}
                </Badge>
              </div>
            </div>
          )
        }

        {
          resource.kpidefinition && (
            <div>
              <h3 class="text-sm font-medium text-gray-500">Related KPI</h3>
              <div class="mt-2">
                <Badge color="secondary" size="md">
                  {resource.kpidefinition.name}
                </Badge>
              </div>
            </div>
          )
        }
      </div>

      {
        resource.description && (
          <div class="prose prose-gray mt-8 max-w-none">
            <InnerHtml html={resource.description} client:load />
          </div>
        )
      }
    </article>
  </main>
</Layout>
