---
interface Props {
  badgeIcon: string;
  badgeText: string;
  title: string;
  highlightedText?: string;
  description: string;
  descriptionClass?: string;
}

const {
  badgeIcon,
  badgeText,
  title,
  highlightedText,
  description,
  descriptionClass = "text-lg text-gray-600 max-w-4xl leading-relaxed",
} = Astro.props;

const splitedTitleText = highlightedText
  ? title.split(highlightedText)
  : [title];
const titleBeforeHighlight = splitedTitleText[0];
const titleAfterHighlight = splitedTitleText[1];
---

<div class="">
  <div
    class="inline-flex items-center gap-2 px-3 py-1 bg-info/10 text-info rounded-full text-sm font-medium"
  >
    <Fragment set:html={badgeIcon} />
    {badgeText}
  </div>
  <h1 class="text-4xl font-bold text-gray-900 mb-4 tracking-tight">
    {titleBeforeHighlight}
    {
      highlightedText && (
        <span class=" text-secondary px-1 rounded">
          {highlightedText}
        </span>
      )
    }
    {titleAfterHighlight}
  </h1>
  <p
    class:list={[
      "text-lg text-gray-600 max-w-4xl leading-relaxed",
      descriptionClass,
    ]}
  >
    {description}
  </p>
</div>
