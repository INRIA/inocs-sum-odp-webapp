---
import Layout from "../../layouts/Layout.astro";
import { TaskCard } from "../../components/react";
import ApiClient from "../../lib/api-client/ApiClient.ts";
import {
  getUrl,
  getLivingLabInfoProgress,
  getModalSplitCardMetrics,
  getKpiResultsCardMetrics,
  getMeasuresProgress,
  computePerLabMetricCards,
  computePerLabAlerts,
  computeLabKpiTimeline,
  computeLabMeasuresBar,
  computeKpiCoverageTable,
} from "../../lib/helpers";
import { MetricCard } from "../../components/react/Analytics/MetricCard";
import { D3LineChartLabKPIsOvertime } from "../../components/react/Analytics/D3LineChartLabKPIsOvertime";
import { D3BarChartLabMeasures } from "../../components/react/Analytics/D3BarChartLabMeasures";
import { KPICoverageTable } from "../../components/react/Analytics/KPICoverageTable";
import { AnalyticsAlerts } from "../../components/react/Analytics/AnalyticsAlerts";

const labId = Astro.locals.livingLab?.id;
if (!labId) {
  return Astro.redirect(getUrl("/lab-admin/set-lab"));
}
const user = Astro.locals.user;
const api = new ApiClient(Astro.request);

const kpis = await api.getKPIs({});
const livingLab = await api.getLivingLab(labId);
const modalSplitKpi = kpis?.find((kpi) => kpi.kpi_number === "15");
const modalSplitKpis =
  kpis?.filter((kpi) =>
    [kpi.id, kpi.parent_kpi_id].includes(modalSplitKpi?.id),
  ) ?? [];
const modalSplitKpiIds = new Set(modalSplitKpis.map((kpi) => kpi.id));
const nonModalSplitKpis =
  kpis?.filter((kpi) => !kpi.kpi_number.startsWith("15")) ?? [];
const modalSplitResultGroups =
  livingLab?.kpi_results?.filter((result) =>
    modalSplitKpiIds.has(result.kpidefinition_id),
  ) ?? [];
const nonModalSplitResultGroups =
  livingLab?.kpi_results?.filter(
    (result) => !modalSplitKpiIds.has(result.kpidefinition_id),
  ) ?? [];

const labInfoProgress = getLivingLabInfoProgress(livingLab);
const modalSplitMetrics = getModalSplitCardMetrics(
  modalSplitResultGroups,
  livingLab?.transport_modes ?? [],
);
const kpisMetrics = getKpiResultsCardMetrics(
  kpis ?? [],
  nonModalSplitResultGroups,
);
const measuresProgress = getMeasuresProgress(livingLab?.projects ?? []);

// Per-lab analytics
const labForAnalytics = livingLab ?? {
  id: Number(labId),
  name: "",
  kpi_results: [],
  living_lab_projects_implementation: [],
};
const perLabMetricCards = computePerLabMetricCards(labForAnalytics, kpis ?? []);
const perLabAlerts = computePerLabAlerts(labForAnalytics, kpis ?? []);
const labKpiTimeline = computeLabKpiTimeline([labForAnalytics]);
const labMeasuresBar = computeLabMeasuresBar([labForAnalytics]);
const kpiCoverageTable = computeKpiCoverageTable([labForAnalytics], kpis ?? []);

const stepsCTA = [
  {
    id: "lab-info",
    title: "Lab information",
    ctaLabel: "Update living lab",
    ctaLink: getUrl("/lab-admin/lab/edit"),
    progress: labInfoProgress.progress,
    value: `${labInfoProgress.value}`,
    details: labInfoProgress.details,
  },
  {
    id: "measures",
    title: "Measures implemented",
    ctaLabel: "Edit measures",
    ctaLink: getUrl("/lab-admin/measures"),
    progress: measuresProgress.progress,
    value: measuresProgress.value,
    details: measuresProgress.details,
  },
  {
    id: "modal-split",
    title: "Modal split results",
    ctaLabel: "Edit modal split",
    ctaLink: getUrl("/lab-admin/modal-split"),
    value: modalSplitMetrics.value,
    details: modalSplitMetrics.details,
  },
  {
    id: "kpis",
    title: "KPIs results",
    ctaLabel: "Edit KPIs",
    ctaLink: getUrl("/lab-admin/kpis"),
    value: kpisMetrics.value,
    details: kpisMetrics.details,
  },
];
---

<Layout
  role="editor"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Lab dashboard" }]}
  backHref="/"
>
  <div class="">
    <section
      class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8 flex flex-col gap-10 lg:gap-18"
    >
      <div class="flex flex-col gap-4">
        <h2>Welcome {user?.name}</h2>
        <h3>
          You are managing data for the<br />
          <strong class="text-success">Living Lab {livingLab?.name}</strong>
        </h3>
        <p>
          Help us improve urban mobility by contributing your city’s data to the
          Open Data Platform for Seamless Shared Urban Mobility.
        </p>
      </div>

      <!-- <LabDashboardTabs client:load progress={progressItems} alerts={alerts} /> -->

      <div class="grid gap-10 grid-cols-1">
        <h3 class="text-center">Manage living lab data</h3>
        <div class="grid gap-2 lg:gap-10 grid-cols-1 md:grid-cols-2">
          {
            stepsCTA.map((step, i) => (
              <TaskCard
                title={step.title}
                ctaLabel={step.ctaLabel}
                ctaLink={step.ctaLink}
                progress={step.progress}
                value={step.value}
                details={step.details}
                client:load
              />
            ))
          }
        </div>
      </div>

      <!-- Per-lab analytics -->
      <div class="flex flex-col gap-10">
        <h3 class="text-center">Your lab analytics</h3>

        <!-- Metric cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {perLabMetricCards.map((card) => <MetricCard data={card} />)}
        </div>

        <!-- Charts + Alerts -->
        <div class="flex flex-row gap-1 md:gap-4">
          <div class="w-2/3 grid grid-cols-1 gap-8">
            <!-- KPI Results Over Time -->
            <section class="bg-white rounded-lg shadow p-6">
              <h4 class="font-semibold mb-4">KPI Results Over Time</h4>
              <div class="h-80">
                {
                  labKpiTimeline[0]?.dataPoints.length > 0 ? (
                    <D3LineChartLabKPIsOvertime
                      data={labKpiTimeline}
                      client:load
                    />
                  ) : (
                    <div class="h-full flex items-center justify-center text-gray-400">
                      <p class="text-sm">No KPI data recorded yet</p>
                    </div>
                  )
                }
              </div>
            </section>

            <!-- Measures Bar Chart -->
            <section class="bg-white rounded-lg shadow p-6">
              <h4 class="font-semibold mb-4">Measures by Type</h4>
              <div class="h-80">
                {
                  (labMeasuresBar[0]?.pushCount ?? 0) +
                    (labMeasuresBar[0]?.pullCount ?? 0) >
                  0 ? (
                    <D3BarChartLabMeasures data={labMeasuresBar} client:load />
                  ) : (
                    <div class="h-full flex items-center justify-center text-gray-400">
                      <p class="text-sm">No measures recorded yet</p>
                    </div>
                  )
                }
              </div>
            </section>
          </div>

          <!-- Alerts -->
          <section class="w-1/3 p-1 lg:p-4 bg-white shadow rounded-lg">
            <h4 class="font-semibold mb-4">Attention required</h4>
            {
              perLabAlerts.length > 0 ? (
                <AnalyticsAlerts alerts={perLabAlerts} />
              ) : (
                <p class="text-sm text-gray-400">No issues detected</p>
              )
            }
          </section>
        </div>

        <!-- KPI Coverage Table -->
        <section>
          <h4 class="font-semibold mb-4">KPI Coverage</h4>
          <KPICoverageTable rows={kpiCoverageTable} />
        </section>
      </div>

      {/* Help Section */}
      <div
        class="hidden mt-12 p-6 bg-gray-50 border border-gray-200 rounded-lg"
      >
        <h3 class="text-lg font-semibold text-gray-800 mb-2">
          Need help completing a step?
        </h3>
        <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
          <li>
            <a href="/resources" class="text-blue-800 hover:underline">
              Access your Living Lab onboarding guide
            </a>
          </li>
          <li>
            <a href="/faq" class="text-blue-800 hover:underline">
              Visit the FAQ
            </a>
          </li>
          <li>
            <a
              href="mailto:support@sum-project.eu"
              class="text-blue-800 hover:underline"
            >
              Contact the SUM coordination team
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
