---
interface Step {
  number: number;
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle: string;
  steps: Step[];
}

const { title, subtitle, steps } = Astro.props;
---

<details class="group mb-12">
  <summary
    class="cursor-pointer bg-white from-slate-50 to-blue-50 rounded-xl p-6 border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all duration-200 list-none group-open:bg-info/10"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div
          class="p-2 bg-light rounded-lg text-dark group-open:text-white group-open:bg-info transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-gray-900">
            {title}
          </h3>
          <p class="text-sm text-gray-500">
            {subtitle}
          </p>
        </div>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </div>
  </summary>

  <div
    class="bg-info/5 rounded-b-xl p-8 border-x border-b border-gray-200 mt-2"
  >
    <div class="grid md:grid-cols-3 gap-8 relative">
      <!-- Connection Line (hidden on mobile) -->
      <div
        class="hidden md:block absolute top-8 left-0 right-0 h-0.5 bg-gradient-to-r from-blue-200 via-indigo-200 to-violet-200"
        style="margin: 0 12%;"
      >
      </div>

      {
        steps.map((step) => (
          <div class="relative">
            <div class="flex flex-col items-center md:items-start">
              <div class="relative z-10 flex items-center justify-center w-16 h-16 bg-primary/90 text-white rounded-2xl font-bold text-xl shadow-lg mb-4">
                {step.number}
              </div>
              <h4 class="font-semibold text-gray-900 mb-2 text-center md:text-left">
                {step.title}
              </h4>
              <p class="text-sm text-gray-600 text-center md:text-left leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</details>
