---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { RButton, SidebarMenu, SiteNavBar } from "../components/react/ui";
import ApiClient from "../lib/api-client/ApiClient";
import { getUrl } from "../lib/helpers";
import { Breadcrumbs, type BreadcrumbItem } from "../components/Breadcrumbs";
import { ArrowLeftIcon } from "@heroicons/react/20/solid";

interface Props {
  role?: "visitor" | "editor" | "admin";
  /** Optional breadcrumb navigation items. When provided, displays a breadcrumb trail above the main content. */
  breadcrumbs?: BreadcrumbItem[];
  /** Optional back button URL. When provided, displays a back button alongside breadcrumbs. */
  backHref?: string;
}

const { role = "visitor", breadcrumbs, backHref } = Astro.props;

/** Whether to show the navigation bar (breadcrumbs and/or back button) */
const showNavBar = breadcrumbs || backHref;
const api = new ApiClient(Astro.request);
const labs = await api.getLivingLabs([]);
const labsItems = labs?.map((lab) => ({
  href: getUrl(`/living-lab-city/${lab.id}`),
  label: lab.name,
}));

const userInfo = Astro.locals.user
  ? {
      name: Astro.locals.user?.name ?? "User",
      email: Astro.locals.user?.email ?? "",
    }
  : undefined;

const currentLivingLab = Astro.locals.livingLab;

const menuItems = [
  {
    label: "Home",
    href: getUrl("/"),
  },
  {
    label: "Living Labs",
    subItems: labsItems,
  },
  {
    label: "Data",
    subItems: [
      { href: "/data/measures", label: "Policy measures" },
      { href: "/data/kpis", label: "KPIs" },
      // { href: "#", label: "Modal split" },
    ],
  },
  {
    label: "Tools",
    subItems: [
      { href: "/tools/impact_analysis", label: "Impact analysis" },
      { href: "/tools/mcda_analysis", label: "Multi‑criteria decision tool" },
    ],
  },
  { href: "/tools/resources", label: "Resources" },
];

const footerMenuItems = [
  {
    title: "Open Data Platform",
    items: [
      { label: "About", href: getUrl("/") },
      { label: "Measures", href: getUrl("/data/measures") },
      { label: "FAQ", href: getUrl("/faq") },
      // { label: "Analysis Tools", href: "#" },
    ],
  },
  {
    title: "SUM project",
    items: [
      {
        label: "About",
        href: "https://sum-project.eu/about",
      },
      { label: "Partners", href: "https://sum-project.eu/partners" },
      { label: "Resources", href: "https://sum-project.eu/resources/" },
      { label: "Contact", href: "https://sum-project.eu/contact/" },
    ],
  },
  {
    title: "Living Labs",
    items: labsItems,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href={getUrl("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <title>SUM Open Data Platform</title>

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={getUrl("/apple-touch-icon.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={getUrl("/favicon-32x32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={getUrl("/favicon-16x16.png")}
    />
    <link rel="manifest" href={getUrl("/site.webmanifest")} />
  </head>
  <body>
    {
      role === "visitor" && (
        <SiteNavBar
          menuItems={menuItems}
          userInfo={userInfo}
          currentLivingLab={currentLivingLab}
          client:load
        >
          {showNavBar && (
            <div class="nav-bar mb-4 flex flex-col gap-2 px-4 sm:flex-row sm:items-center sm:justify-between">
              {breadcrumbs && (
                <Breadcrumbs
                  items={breadcrumbs}
                  class="hidden overflow-x-auto sm:flex"
                />
              )}
              {backHref && (
                <RButton
                  variant="link"
                  href={backHref}
                  className="inline-flex items-center gap-2"
                >
                  <ArrowLeftIcon className="h-5 w-5" />
                  Back to Resources
                </RButton>
              )}
            </div>
          )}
          <slot />
        </SiteNavBar>
      )
    }
    {
      role === "editor" && (
        <SidebarMenu
          userInfo={userInfo}
          currentLivingLab={currentLivingLab}
          client:load
        >
          {showNavBar && (
            <div class="nav-bar mb-4 flex flex-col gap-2 px-4 sm:flex-row sm:items-center sm:justify-between">
              {backHref ? (
                <a
                  href={backHref}
                  class="inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-900"
                >
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"
                    />
                  </svg>
                  <span class="sm:hidden">Back</span>
                </a>
              ) : (
                <div />
              )}
              {breadcrumbs && (
                <Breadcrumbs
                  items={breadcrumbs}
                  class="hidden overflow-x-auto sm:flex"
                />
              )}
            </div>
          )}
          <slot />
        </SidebarMenu>
      )
    }

    <Footer sections={footerMenuItems} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
