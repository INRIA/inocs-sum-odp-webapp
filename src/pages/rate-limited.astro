---
import Layout from "../layouts/Layout.astro";

const from = Astro.url.searchParams.get("from") ?? "/";
const retryHref = from.startsWith("/") && !from.startsWith("//") ? from : "/";

Astro.response.status = 429;
---

<Layout>
  <main class="min-h-[60vh] flex items-center justify-center bg-gray-50 p-6">
    <div class="max-w-2xl w-full text-center bg-white rounded-lg shadow-md p-8">
      <h1 class="text-2xl md:text-3xl font-semibold mb-4 text-gray-900">
        Service currently unavailable
      </h1>

      <p class="text-gray-700 mb-6 leading-relaxed">
        Too many requests were received from your network. Please wait a moment
        and try again.
      </p>

      <div>
        <a
          href={retryHref}
          class="inline-block px-4 py-2 bg-primary text-white rounded hover:bg-info"
        >
          Try again
        </a>
      </div>
    </div>
  </main>
</Layout>
