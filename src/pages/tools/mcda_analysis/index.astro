    features: [
      "Real implemented policy measures in living labs",
      "Actual performance metrics KPIs from living labs",
      "Evidence-based decision making",
    ],
    bestFor: "Policy Review",
    cta: {
      label: "Launch KPI Version",
      href: "/tools/mcda_analysis/mcda_analysis_quantitative/regulatory",
      variant: "primary" as const,
    },
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
