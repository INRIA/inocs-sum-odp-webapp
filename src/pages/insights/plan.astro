---
import Layout from "../../layouts/Layout.astro";
import { GuidedMCDAWizard } from "../../components/react/Insights/GuidedMCDAWizard";
import {
  CUSTOM_MCDA_DEFAULT_GOALS,
  CUSTOM_MCDA_DEFAULT_ACTIVITIES,
} from "../../lib/helpers";
import { getUrl } from "../../lib/helpers";

const goals = CUSTOM_MCDA_DEFAULT_GOALS.map((name) => ({ name, weight: 1 }));
const alternatives = CUSTOM_MCDA_DEFAULT_ACTIVITIES.map((name) => ({ name }));
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Insights", href: "/insights/measures" },
    { label: "Plan for my city" },
  ]}
  backHref="/insights/measures"
>
  <section class="py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-900 mb-3">Plan for my city</h1>
      <p class="text-lg text-gray-600 mb-2">
        Answer three questions about your city to get a ranked shortlist of
        mobility measures tailored to your priorities — no specialised
        knowledge required.
      </p>
    </div>
  </section>

  <GuidedMCDAWizard
    goals={goals}
    alternatives={alternatives}
    expertBaseUrl={getUrl("/tools/mcda_analysis/user_personalized/")}
    client:load
  />
</Layout>
