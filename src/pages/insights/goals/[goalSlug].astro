---
import Layout from "../../../layouts/Layout.astro";
import { MeasureCard } from "../../../components/react/Insights";
import { GOALS } from "../../../lib/insights/goals";
import { getMeasuresForGoal } from "../../../lib/insights/goalHelpers";
import ApiClient from "../../../lib/api-client/ApiClient";
import { getUrl } from "../../../lib/helpers";
import type { ILivingLab } from "../../../types";

const { goalSlug } = Astro.params;

const goal = GOALS.find((g) => g.slug === goalSlug);

if (!goal) {
  return Astro.redirect(getUrl("/insights/goals"));
}

const api = new ApiClient(Astro.request);
const jobRun = await api.getLatestJobRun("kpi_measures_analysis");
const successItems = jobRun?.output_data?.success ?? [];
const livingLabsRaw = (await api.getLivingLabs([])) ?? [];
const livingLabs = livingLabsRaw as ILivingLab[];

const measures = getMeasuresForGoal(goal, successItems, livingLabs);
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: getUrl("/") },
    { label: "Insights", href: getUrl("/insights") },
    { label: "What works", href: getUrl("/insights/goals") },
    { label: goal.title },
  ]}
  backHref={getUrl("/insights/goals")}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-3">{goal.title}</h1>
      <p class="text-gray-500 text-lg">{goal.description}</p>
    </div>

    {
      measures.length === 0 ? (
        <div class="rounded-xl border border-gray-100 bg-gray-50 p-8 text-center text-gray-400">
          No measures with qualifying evidence found for this goal yet.
        </div>
      ) : (
        <div class="space-y-4">
          {measures.map((m, idx) => (
            <MeasureCard
              rank={idx + 1}
              measureName={m.plainName}
              cityCount={m.cityCount}
              cities={m.contributingCities}
              outcome={m.outcomeDescription}
              evidenceLabel={m.evidenceLabel}
              client:load
            />
          ))}
        </div>
      )
    }

    <div class="mt-10 rounded-xl border border-blue-100 bg-blue-50 p-6">
      <p class="text-sm text-blue-800">
        Explore the underlying KPI data in the{" "}
        <a href={getUrl("/data/kpis")} class="font-medium underline hover:text-blue-900">
          Data & KPIs dashboard
        </a>.
      </p>
    </div>
  </div>
</Layout>
