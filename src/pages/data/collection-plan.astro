---
import Layout from "../../layouts/Layout.astro";
import HowToUseAccordion from "../../components/AnalysisPageSections/HowToUseAccordion.astro";
import FeaturesGrid from "../../components/AnalysisPageSections/FeaturesGrid.astro";
import { InfoAlert, KpisFrameworkDiagram } from "../../components/react";
import {
  NumberedListIcon,
  DocumentTextIcon,
  TableCellsIcon,
} from "@heroicons/react/20/solid";
import {
  ArrowDownTrayIcon,
  ArrowTopRightOnSquareIcon,
} from "@heroicons/react/24/outline";

const collectionPlanSteps = [
  {
    number: 1,
    title: "Review KPI Requirements",
    description:
      "Start by thoroughly reading the KPI Framework document to understand what data you need to collect for each metric.",
  },
  {
    number: 2,
    title: "Identify available data sources",
    description:
      "Map out existing data sources in your city (transport authority, municipality, operators) and identify gaps that need new collection methods.",
  },
  {
    number: 3,
    title: "Adapt resources to your context",
    description:
      "Customize the spreadsheet and survey templates to match your city's specific needs, available resources, and local language.",
  },
  {
    number: 4,
    title: "Implement collection and calculate KPIs",
    description:
      "Execute your data collection plan and use the provided tools to organize and calculate your KPI values before entering them into the platform.",
  },
];

const resourcesFeatures: any[] = [
  {
    iconComponent: DocumentTextIcon,
    title: "KPI SIEF Framework & Formulas",
    description:
      "Comprehensive documentation explaining each KPI, calculation methodologies, data requirements, and scientific framework for NSM-PT integration metrics.",
    badge: {
      label: "REQUIRED",
      color: "warning",
      className: "bg-danger/20 text-danger border-danger/20",
    },
    ctas: [
      {
        label: "Download Guide",
        href: "/files/SUM_D1.2_KPI Review_V1.0_FINAL.pdf",
        variant: "primary",
        iconComponent: ArrowDownTrayIcon,
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ],
  },
  {
    iconComponent: TableCellsIcon,
    title: "KPI Calculation Spreadsheet",
    description:
      "Pre-built Excel template with formulas and data validation to help you organize raw data and calculate KPI values. Includes examples and instructions.",
    badge: {
      label: "OPTIONAL",
      color: "light",
      className: "bg-gray-100 text-gray-700 border-gray-200",
    },
    ctas: [
      {
        label: "Download Template",
        href: "/files/SIEF_All_KPIs-template.xlsx",
        variant: "primary",
        iconComponent: ArrowDownTrayIcon,
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ],
  },
  {
    iconComponent: NumberedListIcon,
    title: "Survey Template (English)",
    description:
      "Sample survey questionnaire designed to collect citizen feedback and usage data for relevant KPIs. Can be adapted and translated for your city's specific context.",
    badge: {
      label: "OPTIONAL",
      color: "light",
      className: "bg-gray-100 text-gray-700 border-gray-200",
    },
    ctas: [
      {
        label: "Download Guide",
        href: "/files/SUM_survey_template.pdf",
        variant: "primary",
        iconComponent: ArrowDownTrayIcon,
        target: "_blank",
        rel: "noopener noreferrer",
      },
      {
        label: "Duplicate Microsoft Forms template",
        href: "https://forms.cloud.microsoft/Pages/ShareFormPage.aspx?id=DQSIkWdsW0yxEjajBLZtrQAAAAAAAAAAAANAAQXN0CpURDJQMzZCMEFEMUMzT04zSURDWjdOWTlPVS4u&sharetoken=6TrOGxDjd9EBJAA7Hhg3",
        variant: "secondary",
        iconComponent: ArrowTopRightOnSquareIcon,
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ],
  },
];

const whyDataMattersFeatures: any[] = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
    </svg>`,
    title: "Scientific Evidence Base",
    description:
      "Building a robust dataset that demonstrates the impact of integration policies.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"></path>
    </svg>`,
    title: "Comparative Insights",
    description:
      "Understanding how your city performs relative to others with similar characteristics.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"></path>
    </svg>`,
    title: "Policy Learning",
    description:
      "Identifying which measures drive meaningful improvements in NSM-PT integration.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"></path>
    </svg>`,
    title: "Collective Impact",
    description:
      "More participating cities means stronger evidence for policy change and investment.",
  },
];
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Data" },
    { label: "KPI Data Collection Planning" },
  ]}
  backHref="/"
>
  <div class="mx-auto px-1 py-8 flex flex-col gap-8">
    <!-- Page Header -->
    <div>
      <h1>
        KPI <span class="text-secondary">Data Collection</span> Planning
      </h1>
      <p class="text-gray-600 text-lg">
        Resources and tools to help you collect and calculate KPI data for your
        city.
      </p>
    </div>

    <!-- Before You Begin -->
    <InfoAlert title="Before You Begin" icon="info" variant="info" client:load>
      <span>
        We understand that collecting KPI data can be complex. To support you,
        we've prepared comprehensive resources to guide your data collection
        process.
        <br />
        <strong
          >These resources are optional and helpful information to get you
          started, you are free to use these or your own tools as you see fit.
          The main goal is to support your data collection efforts effectively.</strong
        >
        <br />
        Take time to review the materials below and develop a data collection plan
        tailored to your city's needs and available resources.
      </span>
    </InfoAlert>

    <!-- Available Resources -->
    <section>
      <h2 class="mb-4">Available Resources</h2>
      <FeaturesGrid features={resourcesFeatures} columns={3} className="mb-0" />
    </section>

    <!-- KPIs framework -->
    <KpisFrameworkDiagram />
    <!-- Developing Your Data Collection Plan -->
    <HowToUseAccordion
      title="Developing your data collection plan"
      subtitle="Follow these steps to build an effective data collection strategy"
      steps={collectionPlanSteps}
      vertical={true}
    />

    <!-- Important Notes -->
    <InfoAlert
      title="Important notes"
      icon="warning"
      variant="warning"
      client:load
    >
      <ul class="mt-1 space-y-2 list-none">
        <li class="flex items-start gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 w-4 h-4 shrink-0"
          >
            <path
              fill-rule="evenodd"
              d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >These resources provide guidance for many, but not all KPIs. Some
            metrics may require city-specific data collection approaches.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 w-4 h-4 shrink-0"
          >
            <path
              fill-rule="evenodd"
              d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >The survey template is a starting point. Adapt questions to your
            local context and ensure compliance with data protection
            regulations.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 w-4 h-4 shrink-0"
          >
            <path
              fill-rule="evenodd"
              d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >Data quality is crucial for meaningful insights. Take time to
            ensure accuracy in your collection and calculation processes.</span
          >
        </li>
      </ul>
    </InfoAlert>

    <!-- Why Your Data Matters -->
    <section class="p-4 md:p-6">
      <div class="mb-4">
        <h3 class="font-semibold text-primary text-base mb-1">
          Why Your Data Matters
        </h3>
        <p class="text-sm text-primary">
          This platform tracks KPIs and policy measures across cities working to
          integrate New Shared Modes (NSM) with Public Transport (PT). Your
          participation contributes to:
        </p>
      </div>
      <FeaturesGrid
        features={whyDataMattersFeatures}
        columns={2}
        className="mb-0"
      />
    </section>

    <!-- CTA -->
    <InfoAlert
      title="Ready to Enter Your KPI Data?"
      icon="success"
      variant="neutral"
      actionHref="/lab-admin/login"
      actionText="Signin"
      client:load
      ><p class="text-sm text-gray-600">
        Once you've collected and calculated your data, proceed to login to your
        living lab administration dashboard to enter your KPI values and
        contribute to our collective understanding of NSM-PT integration
        impacts.
      </p></InfoAlert
    >
  </div>
</Layout>
