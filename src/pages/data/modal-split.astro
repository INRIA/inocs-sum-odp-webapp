---
import Layout from "../../layouts/Layout.astro";
import ApiClient from "../../lib/api-client/ApiClient";
import { KPIsDashboard } from "../../components/react";
import { getModalSplitDataForDashboard } from "../../lib/helpers/living-lab";
import type { ILivingLabPopulated } from "../../types";

const api = new ApiClient(Astro.request);

// Fetch all living labs with KPI results
const livingLabsData =
  ((await api.getLivingLabs(["kpiresults"])) as ILivingLabPopulated[]) ?? [];

// Fetch all KPI definitions
const allKpis = (await api.getKPIs({ kpi_number: "15" })) ?? [];

// Fetch transport modes for modal split display
const transportModes = (await api.getTransportModes()) ?? [];

// Extract unique years from all KPI results for filtering
const allYears = new Set<number>();
const filteredLivingLabs = livingLabsData.filter(
  (lab) => lab.kpi_results && lab.kpi_results.length > 0,
);

filteredLivingLabs.forEach((lab) => {
  lab.kpi_results?.forEach((result) => {
    if (result.result_before?.date) {
      allYears.add(new Date(result.result_before.date).getFullYear());
    }
    if (result.result_after?.date) {
      allYears.add(new Date(result.result_after.date).getFullYear());
    }
  });
});
const sortedYears = Array.from(allYears).sort((a, b) => a - b);

// Prepare living labs data for the dashboard
const livingLabsForDashboard = filteredLivingLabs.map((lab) => ({
  id: lab.id,
  name: lab.name,
  kpiResults: lab.kpi_results ?? [],
}));

// Process modal split data on SSR for performance (no heavy mapping on client)
const modalSplitData = getModalSplitDataForDashboard(
  allKpis,
  transportModes,
  livingLabsForDashboard,
);
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Data" },
    { label: "Modal Split" },
  ]}
  backHref="/"
>
  <div class="mx-auto px-1 py-8" id="data-dashboard-top">
    <!-- Page Header -->
    <div class="mb-8">
      <h1>
        <span class="text-secondary">Modal Split KPI</span>
        implemented for
        <span class="text-secondary">SEAMLESS </span>
        Shared Urban Mobility
      </h1>
      <p class="text-gray-600 text-lg">
        Compare Modal Split KPI across all Living Labs. Each chart displays KPI
        values over time, with each living lab represented by a unique color.
      </p>
    </div>

    {
      livingLabsForDashboard.length === 0 ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-8 text-center">
          <div class="text-6xl mb-4">📊</div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            No Data Available
          </h2>
          <p class="text-gray-700 text-lg">
            No living labs with KPI data found. Please check back later.
          </p>
        </div>
      ) : (
        <KPIsDashboard
          livingLabs={livingLabsForDashboard}
          kpis={[]}
          availableYears={sortedYears}
          categories={[]}
          modalSplitData={modalSplitData}
          transportModes={transportModes}
          client:load
        />
      )
    }
  </div>
</Layout>
