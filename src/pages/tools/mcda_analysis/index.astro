];

---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools" },
    { label: "MCDA Analysis", href: "/tools/mcda_analysis" },
  ]}
  backHref="/"
>
  <div class="mx-auto px-1 py-8">
    <section class="mx-auto px-1 py-8 gap-y-8 flex flex-col">
      <!-- Info Section H1 -->
      <InfoSection
        badgeIcon={badgeIcon}
        badgeText="Decision Support Tool"
        title="Find the Right Policy Measures for Sustainable Shared Mobility in Your City"
        highlightedText="Policy Measures for Sustainable Shared Mobility"
        description="Evidence-based decision support using PROMETHEE-GAIA multi-criteria analysis and expert insights from cities across Europe"
      />

      <!-- Features Grid -->
      <FeaturesGrid features={mcdaFeatures} />

      <div class="flex flex-row justify-center gap-4">
        <RButton variant="secondary" href="#how-to">
          About the methodology
        </RButton>
        <RButton variant="primary" href="#choose-approach">
          Start your analysis
        </RButton>
      </div>
    </section>

    <section id="choose-approach">
      <div class="mx-auto px-1 py-12 border-t border-gray-200">
        <div class="text-center mb-10">
          <h2 class="text-gray-900">How to start your analysis?</h2>
          <p class="text-gray-500 max-w-2xl mx-auto mt-3">
            4 simple steps to get started with your MCDA analysis. Follow the
            guide below.
          </p>
        </div>
        <!-- How to Use Guide -->
        <HowToUseAccordion
          title="How to start your analysis?"
          subtitle="4 simple steps to get started"
          steps={howToUseSteps}
          defaultOpen={true}
          hideSummary
        />
      </div>
      <div class="mx-auto px-1 py-12 border-t border-gray-200">
        <div class="text-center mb-10">
          <h2 class="text-gray-900">
            Choose Your Analysis Approach & Data Source
          </h2>
          <p class="text-gray-500 max-w-2xl mx-auto mt-3">
            Select the version that best fits your data availability and
            analysis needs. Each version provides comprehensive insights using
            the PROMETHEE GAIA methodology.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            analysisApproaches.map((approach) => (
              <AnalysisFeatureCard {...approach} />
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="how-to"
      class="mx-auto px-1 py-8 gap-y-0 flex flex-col border-t border-gray-200"
    >
      <div class="text-center mb-10">
        <h2 class="text-gray-900">Understanding the Methodology</h2>
      </div>
      <!-- Methodology summary + link -->
      <MethodologyAccordion
        title="PROMETHEE-GAIA Multi-Criteria Analysis"
        subtitle="Multi-criteria decision analysis approach with PROMETHEE and GAIA visualization"
        content=""
      >
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          PROMETHEE ranks policy alternatives by computing net preference flows
          across multiple criteria simultaneously. GAIA provides a 2D visual
          complement that reveals trade-offs and stakeholder alignment. The
          decision stick summarises the overall preferred direction.
        </p>
        <a
          href="/methods/how-models-work"
          class="text-sm font-medium text-primary hover:underline"
        >
          Read more about PROMETHEE and GAIA →
        </a>
      </MethodologyAccordion>

      <MethodologyAccordion
        title="How to interpret the results ?"
        subtitle="Understanding Multi-Criteria Analysis outputs and model accuracy"
        content=""
      >
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          Higher net flow (φ) means an alternative outperforms others across
          more criteria. The GAIA plane shows trade-offs between criteria and
          how alternatives align with each criterion. Compare results across
          perspectives to identify measures that work well for multiple
          stakeholders.
        </p>
        <div class="flex gap-4 flex-wrap">
          <a
            href="/methods/how-models-work"
            class="text-sm font-medium text-primary hover:underline"
          >
            Read more about interpreting results →
          </a>
          <a
            href="/methods/limitations"
            class="text-sm font-medium text-primary hover:underline"
          >
            View limitations & caveats →
          </a>
        </div>
      </MethodologyAccordion>

      <!-- Compare all perspectives CTA -->
      <div class="mt-6 p-6 bg-primary/5 rounded-xl border border-primary/20 text-center">
        <h3 class="font-semibold text-dark mb-2">
          Want to compare all perspectives at once?
        </h3>
        <p class="text-sm text-gray-600 mb-4">
          See how Regulatory, PTO, and NSM Provider rankings agree or diverge
          in a single side-by-side view.
        </p>
        <a
          href="/tools/mcda_analysis/comparison"
          class="inline-block rounded-lg px-5 py-2 bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition-colors"
        >
          Compare all perspectives →
        </a>
      </div>
    </section>
  </div>
</Layout>
