---
import Layout from "../../layouts/Layout.astro";
import { InfoAlert, Timeline } from "../../components/react/ui";

const validationSteps = [
  {
    stepLabel: "Step 1",
    title: "Submission",
    description:
      "City submits — A Living Lab data editor enters KPI values, measures and modal split figures for a given reporting period.",
    footnote: "Draft — not yet visible",
  },
  {
    stepLabel: "Step 2",
    title: "Format & completeness check",
    description:
      "Automatic — Values are checked against the data type, unit and expected range defined for each KPI in the SIEF framework, and the required fields needed to compute it are verified.",
    footnote: "Rejected at entry, with the reason shown",
  },
  {
    stepLabel: "Step 3",
    title: "Consistency cross-check",
    description:
      "Administrator — Values are compared against known ranges and against the city's own earlier submissions to surface anomalies.",
    footnote: "Queried with the city before publication",
  },
  {
    stepLabel: "Step 4",
    title: "Validation & publication",
    description:
      "The Administrator confirms the submission as validated and stamps it with a validation date.",
    footnote: "Live in dashboards, analyses and downloads",
  },
];
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Methods & quality" },
    { label: "Data quality" },
  ]}
  backHref="/methods/evaluation-framework"
>
  <div class="mx-auto px-4 py-8 max-w-[1080px]">
    <h1 class="text-3xl font-bold text-primary mb-3">
      Data quality
    </h1>
    <p class="text-base text-dark max-w-[62ch] mb-2">
      Every figure on this platform comes from a city that measured it and a review process that
      checked it. This page explains how data is validated before it is published and how quality
      is communicated to users.
    </p>
    <div class="w-14 h-1 rounded bg-primary mb-8"></div>

    <section class="mt-6">
      <span
        class="inline-block text-xs font-bold tracking-widest uppercase text-primary bg-primary/7 px-3 py-1 rounded-full mb-3"
      >
        Part 1 — Data quality
      </span>
      <h2 class="text-2xl font-bold text-primary mb-2">How data is validated</h2>
      <p class="text-dark max-w-[70ch] mb-6">
        Quality is controlled in two places: who is allowed to publish, and what each submission has
        to pass. Nothing reaches a dashboard, an analysis or a download straight from a submission
        form. This is what makes figures comparable across cities.
      </p>

      <!-- Gate step: city approval -->
      <InfoAlert title="A city is approved before it can publish anything" variant="info" client:load>
        <p class="text-sm">
          New cities joining the platform are validated by the ODP Administrator, who also
          cross-checks their data for consistency with the rest of the platform. Only approved
          Living Labs and contributing cities hold a profile that can submit data.
        </p>
      </InfoAlert>

      <p
        class="text-xs font-bold tracking-widest uppercase text-dark mt-6 mb-4 flex items-center gap-3"
      >
        Then, for every submission
        <span class="flex-1 h-px bg-gray-200"></span>
      </p>

      <!-- Validation pipeline -->
      <Timeline steps={validationSteps} client:load />

      <p class="text-sm text-dark border-l-3 border-primary/30 pl-4 mt-6 max-w-[80ch]">
        The platform is owned by <strong>ERTICO</strong> and hosted on the ERTICO Academy website.
        Hosting is being transferred from INRIA, which built and operated the platform during the SUM
        project, to ERTICO during 2026. The validation steps above are unchanged by that transfer.
      </p>
    </section>

    <section>
      <h2>Curator role</h2>
      <p>
        Data quality is overseen by the <strong>SUM Data Curation Team</strong> (placeholder —
        consortium to confirm the named role and responsible person or institution).
      </p>
      <p>
        The curator team is responsible for:
      </p>
      <ul>
        <li>Reviewing submitted data for plausibility and completeness</li>
        <li>Coordinating with cities to resolve data quality issues</li>
        <li>Approving data for publication on the platform</li>
        <li>Maintaining the validation standards documentation</li>
      </ul>
    </section>

    <section>
      <h2>Review cadence</h2>
      <p>
        Data is reviewed on a <strong>Quarterly review cycle</strong> (placeholder — consortium
        to confirm). Cities are encouraged to submit data ahead of each review window to ensure
        timely inclusion in platform analyses.
      </p>
    </section>

    <section>
      <h2>How quality is communicated to users</h2>
      <p>
        The platform uses several visual indicators to communicate data quality:
      </p>
      <ul>
        <li>
          <strong>Evidence strength badges</strong> — Show the normalised ratio of data coverage
          for statistical association results. Three levels: Limited, Moderate, Strong.
        </li>
        <li>
          <strong>Freshness indicators</strong> — Show whether a city's data was recently validated
          or whether it may be outdated.
        </li>
        <li>
          <strong>Curated domain badge</strong> — KPI groups flagged as curated are pre-selected
          as the default view because of their particular relevance to NSM integration.
        </li>
        <li>
          <strong>Validation date</strong> — The date a city's data was last reviewed and confirmed
          by the consortium team.
        </li>
      </ul>
    </section>

    <nav class="not-prose mt-8 flex gap-4 text-sm">
      <a href="/methods/models" class="text-primary hover:underline">Next: How the models work →</a>
    </nav>
  </div>
</Layout>
