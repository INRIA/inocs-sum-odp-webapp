---
import Layout from "../../../layouts/Layout.astro";
import { GoalCard, TopFindings, InsightsCityMap } from "../../../components/react/Insights";
import { GOALS } from "../../../lib/insights/goals";
import {
  countMeasuresForGoal,
  countCitiesForGoal,
  hasQualifyingEvidence,
  computeTopFindings,
} from "../../../lib/insights/goalHelpers";
import ApiClient from "../../../lib/api-client/ApiClient";
import { getUrl } from "../../../lib/helpers";
import type { ILivingLab } from "../../../types";

const api = new ApiClient(Astro.request);
const jobRun = await api.getLatestJobRun("kpi_measures_analysis");
const successItems = jobRun?.output_data?.success ?? [];
const livingLabsRaw = (await api.getLivingLabs([])) ?? [];
const livingLabs = livingLabsRaw as ILivingLab[];

const goalStats = GOALS.map((goal) => ({
  ...goal,
  measureCount: countMeasuresForGoal(goal, successItems),
  cityCount: countCitiesForGoal(goal, successItems),
  hasEvidence: hasQualifyingEvidence(goal, successItems),
})).filter((g) => g.hasEvidence);

const topFindings = computeTopFindings(successItems, GOALS, 3);

const citiesWithEvidence = Array.from(
  new Set(successItems.flatMap((s) => s.results.living_labs_analysis.map((la) => la.id))),
)
  .map((id) => {
    const lab = livingLabs.find((l) => l.id === id);
    return lab ? { id: lab.id, name: lab.name } : null;
  })
  .filter((c): c is { id: number; name: string } => c !== null);
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: getUrl("/") },
    { label: "Insights", href: getUrl("/insights") },
    { label: "What works" },
  ]}
  backHref={getUrl("/insights")}
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-gray-900 mb-3">What works</h1>
      <p class="text-gray-500 text-lg max-w-2xl">
        Explore which mobility measures have shown positive outcomes across SUM Living Labs,
        organised by sustainability goal.
      </p>
    </div>

    {
      goalStats.length === 0 ? (
        <div class="rounded-xl border border-gray-100 bg-gray-50 p-8 text-center text-gray-400">
          No results available yet. Run the impact analysis to see findings here.
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
          {goalStats.map((goal) => (
            <GoalCard
              slug={goal.slug}
              title={goal.title}
              description={goal.description}
              measureCount={goal.measureCount}
              cityCount={goal.cityCount}
              href={getUrl(`/insights/goals/${goal.slug}`)}
              client:load
            />
          ))}
        </div>
      )
    }

    {
      topFindings.length > 0 && (
        <section class="mb-12">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Top findings</h2>
          <TopFindings findings={topFindings} client:load />
        </section>
      )
    }

    {
      citiesWithEvidence.length > 0 && (
        <section class="mb-12">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Cities with evidence</h2>
          <InsightsCityMap cities={citiesWithEvidence} client:load />
        </section>
      )
    }

    <div class="rounded-xl border border-blue-100 bg-blue-50 p-6">
      <p class="text-sm text-blue-800">
        Explore the underlying KPI data in the{" "}
        <a href={getUrl("/data/kpis")} class="font-medium underline hover:text-blue-900">
          Data & KPIs dashboard
        </a>.
      </p>
    </div>
  </div>
</Layout>
