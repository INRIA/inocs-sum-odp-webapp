---
interface Props {
  title: string;
  subtitle: string;
  content: string;
}

const { title, subtitle, content } = Astro.props;
---

<details class="group mb-12">
  <summary
    class="cursor-pointer bg-white from-slate-50 to-blue-50 rounded-xl p-6 border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all duration-200 list-none group-open:bg-info/10"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div
          class="p-2 bg-light rounded-lg text-dark group-open:text-white group-open:bg-info transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">
            {title}
          </h3>
          <p class="text-sm text-gray-500">
            {subtitle}
          </p>
        </div>
      </div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </div>
  </summary>

  <div
    class="bg-info/5 rounded-b-xl p-6 border-x border-b border-gray-200 mt-2"
  >
    <Fragment set:html={content} />
  </div>
</details>
