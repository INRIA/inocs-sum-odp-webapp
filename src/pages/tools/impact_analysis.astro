---
import Layout from "../../layouts/Layout.astro";
import { ImpactAnalysisDashboard } from "../../components/react/ImpactAnalysis";
import {
  InfoSection,
  FeaturesGrid,
  HowToUseAccordion,
  MethodologyAccordion,
} from "../../components/AnalysisPageSections";
import ApiClient from "../../lib/api-client/ApiClient";
import type {
  IJobRun,
  IJobRunOutputData,
  IKpiDefinition,
  IKpiGroup,
  IKpiVariationData,
  ILivingLab,
} from "../../types";
import { calculateKpiVariationsData } from "../../lib/helpers/impact-analysis-format";
import { formatDateWithTime } from "../../lib/helpers";

const api = new ApiClient(Astro.request);

// Fetch the latest successful job run for kpi_measures_analysis
let jobRun: IJobRun | null = null;
let kpiGroups: IKpiGroup[] = [];
let kpiDefinitionsMap: Map<string, IKpiDefinition> = new Map();
let livingLabsMap: Map<string, ILivingLab> = new Map();
let kpiVariationsDataMap: Map<string, IKpiVariationData> = new Map();
let errorMessage: string | null = null;
let formattedDate: string | null = null;
let jobRunOutput: IJobRunOutputData | null = null;
try {
  const response = await api.getLatestJobRun("kpi_measures_analysis");

  const livingLabsResponse = await api.getLivingLabs();
  // Build living labs map for geolocation data
  if (livingLabsResponse) {
    livingLabsResponse.forEach((lab: ILivingLab) => {
      livingLabsMap.set(String(lab.id), lab);
    });
  }
  if (response) {
    jobRun = response;

    // Extract kpi_groups from input_data
    if (jobRun?.input_data?.kpi_groups) {
      kpiGroups = jobRun.input_data.kpi_groups;
      kpiGroups?.forEach((_g) => {
        _g?.kpis?.forEach((kpiDef) => {
          kpiDefinitionsMap.set(String(kpiDef.id), kpiDef);
        });
      });
    }

    // Pre-compute KPI variations for each group (server-side)
    if (jobRun?.output_data?.success) {
      jobRunOutput = {
        success:
          jobRun.output_data.success?.map((item) => ({
            ...item,
            results: {
              ...item.results,
              living_labs_analysis:
                item.results.living_labs_analysis?.map((labAnalysis) => ({
                  ...labAnalysis,
                  kpis: [], //remove kpis from living labs analysis to reduce payload size, as they are already included in the main results and can be accessed via the kpiDefinitionsMap
                })) || [],
            },
          })) || [],
        error: jobRun.output_data.error,
        timestamp: jobRun.output_data.timestamp,
      };
      formattedDate = formatDateWithTime(jobRun.created_at);
      jobRun.output_data.success.forEach((successItem) => {
        try {
          const variationData = calculateKpiVariationsData(
            successItem.results,
            kpiDefinitionsMap,
            livingLabsMap,
          );
          kpiVariationsDataMap.set(String(successItem.group_id), variationData);
        } catch (err) {
          console.error(
            `Error calculating variations for group ${successItem.group_id}:`,
            err,
          );
        }
      });
    }
  } else {
    errorMessage = "No successful job run found for KPI measures analysis.";
  }
} catch (error) {
  console.error("Error fetching job run data:", error);
  errorMessage = "Failed to load impact analysis data. Please try again later.";
}

// Convert Map to plain object for JSON serialization
const kpiVariationsData = Object.fromEntries(kpiVariationsDataMap);

// Define badge icon SVG
const badgeIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 16a9.065 9.065 0 0 1-6.23-.693L5 15.3m14.8 0 .384 1.917M5 15.3l-.384 1.917m0 0A9.065 9.065 0 0 0 12 18c2.11 0 4.08-.722 5.634-1.917M4.616 17.217A9.065 9.065 0 0 0 12 21m-7.384-3.783L5 15.3m14.384 1.917L19.8 15.3M12 21c2.11 0 4.08-.722 5.634-1.917"></path>
</svg>`;

// Define features for grid
const impactAnalysisFeatures = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"></path>
    </svg>`,
    title: "Domain-Specific Analysis",
    description:
      "Filter impact data by specific domains such as Sustainability, Traffic Efficiency, or User Acceptance to isolate relevant trends.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"></path>
    </svg>`,
    title: "Measure Attribution",
    description:
      'Identify which specific policies (e.g., "New Bike Lanes", "Parking Restrictions") correlate most strongly with positive or negative KPI shifts.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"></path>
    </svg>`,
    title: "Cross-Lab Comparison",
    description:
      "Aggregated data from all participating cities provides a robust dataset for understanding the global impact of NSM adoption measures.",
  },
];

// Define how-to-use steps
const howToUseSteps = [
  {
    number: 1,
    title: "Select a KPI Domain",
    description:
      'Choose from the dropdown below (e.g., "Sustainability") to filter results by your area of interest.',
  },
  {
    number: 2,
    title: "View Ranked Measures",
    description:
      "See which policies had the most significant positive or negative impact on the selected domain.",
  },
  {
    number: 3,
    title: "Analyze Coefficients",
    description:
      "Understand the magnitude and direction of each measure's impact through detailed regression coefficients.",
  },
];

// Define methodology content
const methodologyContent = `
  <p class="text-sm text-gray-700 leading-relaxed mb-3">
    This analysis employs <strong>regression modeling</strong> to estimate
    the contribution of individual measures to KPI changes. By comparing pre-
    and post-implementation data, we calculate coefficients that represent
    the magnitude and direction of each measure's impact.
  </p>
  <p class="text-sm text-gray-700 leading-relaxed">
    The coefficients shown are derived from a multiple regression
    analysis where each measure is treated as an independent variable,
    and the KPI change is the dependent variable. Positive coefficients
    indicate measures that contributed to KPI improvement, while
    negative values suggest adverse effects or areas requiring
    attention.
  </p>
`;
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Tools" },
    { label: "Impact Analysis" },
  ]}
  backHref="/"
>
  <div class="mx-auto px-1 py-8" id="how-to">
    <div class="mx-auto px-1 py-8 gap-y-4 flex flex-col">
      <!-- Info Section -->
      <InfoSection
        badgeIcon={badgeIcon}
        badgeText="Analysis Tool"
        title="Impact Analysis Dashboard"
        description="Quantifying the effectiveness of mobility measures across Living Labs. This tool uses regression analysis to correlate the implementation of push/pull measures with changes in Key Performance Indicators (KPIs)."
      />

      <!-- Features Grid -->
      <FeaturesGrid features={impactAnalysisFeatures} />

      <!-- How to Use Guide -->
      <HowToUseAccordion
        title="How to Use This Dashboard"
        subtitle="3 simple steps to get started"
        steps={howToUseSteps}
      />

      <!-- Methodology -->
      <MethodologyAccordion
        title="Methodology & Technical Details"
        subtitle="Regression analysis approach"
        content={methodologyContent}
      />
    </div>

    {
      errorMessage || !kpiGroups || kpiGroups.length === 0 ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-8 text-center">
          <div class="text-6xl mb-4">⚠️</div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            No Data Available
          </h2>
          <p class="text-gray-700 text-lg mb-2">
            {errorMessage || "No KPI groups data found in the latest job run."}
          </p>
        </div>
      ) : (
        <section id="impact-results">
          {formattedDate && (
            <p class="text-sm text-gray-500">
              Results where updated on {formattedDate}
            </p>
          )}
          <ImpactAnalysisDashboard
            kpiGroups={kpiGroups}
            jobRunOutput={jobRunOutput}
            kpiVariationsData={kpiVariationsData}
            client:load
          />
        </section>
      )
    }
  </div>
</Layout>
