---
import Layout from "../../layouts/Layout.astro";
import { getUrl, getUrlForAdminHost, isAdminUser } from "../../lib/helpers";
import { AdminHomeCards } from "../../components/react/ui/AdminHomeCards";
import { ShieldCheckIcon } from "@heroicons/react/24/solid";

const user = Astro.locals.user;

// Guard: only admins should reach this page
if (!isAdminUser(user)) {
  return Astro.redirect(getUrl("/lab-admin"));
}

const adminHostUrl = getUrlForAdminHost(Astro.locals);
const editorUrl = getUrl("/lab-admin") + "?as=editor";
---

<Layout
  role="editor"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Administrator home" }]}
>
  <div class="px-4 py-12 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Page header -->
    <div class="mb-10 text-center">
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4"
      >
        <ShieldCheckIcon className="h-8 w-8 text-primary" aria-hidden="true" />
      </div>
      <h2 class="text-2xl font-bold text-gray-900">
        Welcome, {user?.name ?? "Administrator"}
      </h2>
      <p class="mt-2 text-gray-600 max-w-xl mx-auto">
        You have <span class="font-semibold text-primary">Administrator</span> access
        to the SUM Open Data Platform. Choose how you want to work today.
      </p>
    </div>

    <!-- Choice cards -->
    <AdminHomeCards client:load editorUrl={editorUrl} adminHostUrl={adminHostUrl} />

    <!-- Helper hint -->
    <p class="mt-8 text-center text-sm text-gray-500">
      Tip: you can switch to the administration platform at any time from the
      <strong class="font-medium text-gray-700">Admin actions</strong> section
      in the sidebar.
    </p>
  </div>
</Layout>

