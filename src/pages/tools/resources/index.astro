---
import Layout from "../../../layouts/Layout.astro";
import ApiClient from "../../../lib/api-client/ApiClient";
import { ResourcesDashboard } from "../../../components/react/ResourcesDashboard";
import { truncateHtml } from "../../../lib/helpers";
import type { IProject, IResourceCategory, ITag } from "../../../types";

const api = new ApiClient(Astro.request);

const resources = await api.getItemsByCategoryType("RESOURCES");

const categoryMap = new Map<number, IResourceCategory>();
const projectsMap = new Map<number, IProject>();
const tagsMap = new Map<number, ITag>();
resources?.forEach((resource) => {
  if (!categoryMap.has(resource.category_id)) {
    categoryMap.set(resource.category_id, {
      id: resource.category_id,
      name: resource.category.name,
      resources: [],
    });
  }
  categoryMap.get(resource.category_id)!.resources.push({
    ...resource,
    description: truncateHtml(resource.description ?? "", 200),
  });

  if (resource.project) {
    projectsMap.set(resource.project.id, {
      id: resource.project.id,
      name: resource.project.name,
      type: resource.project.type,
    });
  }
  if (resource?.item_tag?.length && resource?.item_tag?.length > 0) {
    resource?.item_tag.forEach((t) => {
      if (!tagsMap.has(t.tags.id)) {
        tagsMap.set(t.tags.id, t.tags);
      }
    });
  }
});
const categories = Array.from(categoryMap.values());
const projects = Array.from(projectsMap.values());
const tags = Array.from(tagsMap.values());
---

<Layout
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/tools/resources" },
  ]}
>
  <main class="mx-auto px-4 py-12">
    <section class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900">Innovation Resources</h1>
      <p class="mt-4 text-lg text-gray-600">
        Discover all of our resources available to support your sustainable
        urban mobility projects and urban shared mobility integration with
        public transport.
      </p>
    </section>

    <ResourcesDashboard
      categories={categories}
      projects={projects}
      tags={tags}
      client:load
    />
  </main>
</Layout>
