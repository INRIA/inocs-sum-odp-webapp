---
interface Props {
  title: string;
  subtitle: string;
  content: string;
  defaultOpen?: boolean;
  variant?: "default" | "info";
}

const {
  title,
  subtitle,
  content,
  defaultOpen = false,
  variant = "default",
} = Astro.props;

const isInfoVariant = variant === "info";
const summaryVariantClasses = isInfoVariant
  ? "bg-info border-info/80 hover:border-info"
  : "bg-white border-gray-200 hover:border-blue-300 group-open:bg-info/10";
const iconVariantClasses = isInfoVariant
  ? "bg-white/20 text-white"
  : "bg-light text-dark group-open:text-white group-open:bg-info";
const titleVariantClasses = isInfoVariant ? "text-white" : "text-gray-900";
const chevronVariantClasses = isInfoVariant ? "text-white/80" : "text-gray-400";
---

<details class="group mb-12" open={defaultOpen || undefined}>
  <summary
    class={`cursor-pointer rounded-xl p-6 border hover:shadow-md transition-all duration-200 list-none ${summaryVariantClasses}`}
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class={`p-2 rounded-lg transition-colors ${iconVariantClasses}`}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class={`font-semibold ${titleVariantClasses}`}>
            {title}
          </h3>
          <p class={`text-sm`}>
            {subtitle}
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <slot name="cta" />
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class={`w-5 h-5 group-open:rotate-180 transition-transform duration-200 ${chevronVariantClasses}`}
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
        </svg>
      </div>
    </div>
  </summary>

  <div
    class="bg-info/5 rounded-b-xl p-6 border-x border-b border-gray-200 mt-2"
  >
    <Fragment set:html={content} />
    <slot />
  </div>
</details>
