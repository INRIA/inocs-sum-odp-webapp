---
import Layout from "../layouts/Layout.astro";
import {
  CTAHero,
  TransportBadge,
  LivingLabsMapSection,
} from "../components/react";
import ExperienceDoor from "../components/ExperienceDoor.astro";
import TrustStrip from "../components/TrustStrip.astro";
import heroImage from "../assets/img/sum-hero.png";
import ApiClient from "../lib/api-client/ApiClient";
import { getUrl, getYearFromDate } from "../lib/helpers";
import { type ILivingLabPopulated } from "../types";
import { COLOR_GREEN } from "../styles/constants";
import { computePlatformCounters } from "../lib/utils/platformCounters";

const api = new ApiClient(Astro.request);

const livingLabsData = (await api.getLivingLabs()) as ILivingLabPopulated[];
const measures = await api.getMeasures();
const allKPIs = await api.getKPIs();
const parentKpis = allKPIs?.filter((kpi) => !kpi.parent_kpi_id);
const transportModes = (await api.getTransportModes())?.filter(
  (tm) => tm.type === "NSM",
);

const labs = livingLabsData?.map((lab) => {
  const kpiSet = new Set<number>();
  const yearsSet = new Set<number>();
  lab.kpi_results
    ?.filter((kpi) => kpi.result_before || kpi.result_after)
    ?.forEach((kpiresult) => {
      const kpiDefinition = allKPIs?.find(
        (pk) => pk.id === kpiresult.kpidefinition_id,
      );
      kpiSet.add(kpiDefinition?.parent_kpi_id ?? kpiDefinition?.id ?? 0);
      const year = getYearFromDate(kpiresult.result_after?.date);
      year && yearsSet.add(year);
    });

  return {
    id: lab.id,
    name: lab.name,
    coordinates: { lat: lab.lat, lng: lab.lng },
    radius: lab.radius ?? 50,
    totalMeasures: lab.projects?.length,
    kpisCollected: kpiSet.size,
    yearsCollected: Array.from(yearsSet),
    transportModes: lab.transport_modes?.filter((tm) => tm.type === "NSM")
      .length,
    sustainablePercentage: 0.4,
  };
});

const platformCounters = computePlatformCounters(livingLabsData ?? []);

const trustCounters = {
  sumLivingLabs: platformCounters.sumLivingLabs,
  contributingCities: platformCounters.contributingCities,
  citiesWithData: platformCounters.citiesWithData,
  measures: measures?.length ?? 0,
  kpis: parentKpis?.length ?? 0,
  lastDataUpdate: platformCounters.lastDataUpdate,
};
---

<Layout role="visitor">
  <CTAHero
    image={heroImage}
    title="Understand how shared mobility policies work"
    subtitle="A Pan-European Open Data Platform tracking the impact of policy measures on New Shared Mobility across 9+ Living Labs."
    primary={{
      text: "Explore data",
      href: getUrl("/data/kpis"),
    }}
    secondary={{
      text: "Get insights",
      href: "#experience-doors",
    }}
    titleTextColor={COLOR_GREEN}
  />

  <!-- Transport badge decoration row -->
  <div class="text-center">
    <div class="flex justify-center flex-wrap gap-1 md:gap-4 my-6">
      <TransportBadge type="bus" size="lg" color="warning" />
      <TransportBadge type="bike" size="lg" color="secondary" />
      <TransportBadge type="metro" size="lg" color="info" />
      <TransportBadge type="car-sharing" size="lg" color="secondary" />
      <TransportBadge type="e-bus" size="lg" color="light" />
      <TransportBadge type="scooter" size="lg" color="secondary" />
    </div>
  </div>

  <!-- Experience Doors -->
  <section id="experience-doors" class="py-12 px-4 sm:px-8 lg:px-16">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ExperienceDoor
          title="Data & Scientific Tools"
          audience="For researchers and analysts"
          entries={[
            { label: "KPI dashboard", href: getUrl("/data/kpis") },
            {
              label: "Impact analysis",
              href: getUrl("/tools/impact_analysis"),
            },
            {
              label: "Multi-criteria decision tool",
              href: getUrl("/tools/mcda_analysis/"),
            },
          ]}
          ctaLabel="Explore"
          ctaHref={getUrl("/data/kpis")}
          variant="data"
        />
        <ExperienceDoor
          title="Insights"
          audience="For policy makers and practitioners"
          entries={[
            { label: "What works (goals)", href: "/insights/goals" },
            { label: "City profiles", href: "/insights/cities" },
            { label: "Plan for my city", href: "/insights/plan" },
          ]}
          ctaLabel="Discover"
          ctaHref="/insights"
          variant="insights"
        />
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <TrustStrip counters={trustCounters} />

  <!-- Map Teaser -->
  <LivingLabsMapSection labs={labs} teaser={true} client:only="react" />

  <!-- Add Your City CTA -->
  <section class="bg-primary/5 py-12 px-4 sm:px-8 lg:px-16 border-t border-primary/10">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-dark mb-3">
        Want to add your city to the platform?
      </h2>
      <p class="text-gray-600 mb-6">
        Join the SUM Open Data Platform and help shape the future of sustainable
        urban mobility across Europe.
      </p>
      <a
        href={getUrl("/join")}
        class="inline-block rounded-lg px-6 py-3 bg-primary text-white font-semibold hover:bg-primary/90 transition-colors"
      >
        Join the project →
      </a>
    </div>
  </section>
</Layout>
