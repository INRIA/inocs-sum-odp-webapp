---
import Layout from "../../layouts/Layout.astro";
import ApiClient from "../../lib/api-client/ApiClient";
import { KPIsDashboard, KpisFrameworkDiagram } from "../../components/react";
import type { ILivingLabPopulated } from "../../types";
import { isImplementationKpi } from "../../config/implementationKpis";

const api = new ApiClient(Astro.request);

// Fetch all living labs with KPI results
const livingLabsData =
  ((await api.getLivingLabs(["kpiresults"])) as ILivingLabPopulated[]) ?? [];

// Fetch all KPI definitions
const allKpis = (await api.getKPIs()) ?? [];
const nonModalSplitKpis = allKpis.filter(
  (kpi) => !kpi.kpi_number.startsWith("15"),
);

// T02: split outcome KPIs from implementation-record KPIs
const outcomeKpis = nonModalSplitKpis.filter(
  (kpi) => !isImplementationKpi(kpi.id),
);
const implementationKpis = nonModalSplitKpis.filter((kpi) =>
  isImplementationKpi(kpi.id),
);

// Fetch all KPI categories
const categories = (await api.getCategories("KPI_SIEF")) ?? [];

// Extract unique years from all KPI results for filtering
const allYears = new Set<number>();
const filteredLivingLabs = livingLabsData.filter(
  (lab) => lab.kpi_results && lab.kpi_results.length > 0,
);

filteredLivingLabs.forEach((lab) => {
  lab.kpi_results?.forEach((result) => {
    if (!nonModalSplitKpis.some((k) => k.id === result.kpidefinition_id)) {
      return;
    }

    result.results?.forEach((entry) => {
      if (entry.date) {
        allYears.add(new Date(entry.date).getFullYear());
      }
    });
  });
});
const sortedYears = Array.from(allYears).sort((a, b) => a - b);

// T03: include validated_at so the sufficiency rule can be applied in the dashboard
const livingLabsForDashboard = filteredLivingLabs.map((lab) => ({
  id: Number(lab.id),
  name: lab.name,
  kpiResults: lab.kpi_results ?? [],
  validated_at: lab.validated_at ?? null,
}));
---

<Layout
  role="visitor"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Data" },
    { label: "KPIs" },
  ]}
  backHref="/"
>
  <div class="mx-auto px-1 py-8" id="data-dashboard-top">
    <!-- Page Header -->
    <div class="mb-8">
      <h1>
        <span class="text-secondary">Key Performance Indicators </span>
        (KPIs) implemented for
        <span class="text-secondary">SEAMLESS </span>
        Shared Urban Mobility
      </h1>
      <p class="text-gray-600 text-lg">
        Compare Key Performance Indicators across all Living Labs. Each chart
        displays KPI values over time, with each living lab represented by a
        unique color.
      </p>
    </div>

    <!-- KPIs framework -->
    <KpisFrameworkDiagram />

    {
      livingLabsForDashboard.length === 0 ? (
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-8 text-center">
          <div class="text-6xl mb-4">📊</div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">
            No Data Available
          </h2>
          <p class="text-gray-700 text-lg">
            No living labs with KPI data found. Please check back later.
          </p>
        </div>
      ) : (
        <KPIsDashboard
          livingLabs={livingLabsForDashboard}
          kpis={outcomeKpis}
          implementationKpis={implementationKpis}
          availableYears={sortedYears}
          categories={categories}
          modalSplitData={[]}
          transportModes={[]}
          client:load
        />
      )
    }
  </div>
</Layout>
