---
import Layout from "../layouts/Layout.astro";

const from = Astro.url.searchParams.get("from") ?? "/";
const retryHref = from.startsWith("/") && !from.startsWith("//") ? from : "/";

Astro.response.status = 429;
---

<Layout>
  <main class="min-h-[60vh] flex items-center justify-center bg-gray-50 p-6">
    <div class="max-w-2xl w-full text-center bg-white rounded-lg shadow-md p-8">
      <div class="flex justify-center mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-20 h-20 text-primary"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
        </svg>
      </div>

      <h1 class="text-2xl md:text-3xl font-semibold mb-4 text-gray-900">
        Whoa, slow down there!
      </h1>

      <p class="text-gray-700 mb-2 leading-relaxed text-lg">
        We've received too many requests from your connection in a short time.
      </p>

      <p class="text-gray-600 mb-6 leading-relaxed">
        This is a safety measure to keep the platform running smoothly for
        everyone. Please take a short break and come back in a minute or two.
      </p>

      <div
        class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6 text-sm text-gray-700"
      >
        <p class="font-medium mb-1">💡 Tip:</p>
        <p>
          If you're experiencing this frequently, try refreshing your pages less
          often or allow data to fully load before navigating.
        </p>
      </div>

      <div>
        <a
          href={retryHref}
          class="inline-block px-6 py-3 bg-primary text-white rounded-lg hover:bg-info transition-colors font-medium"
        >
          Try Again
        </a>
      </div>
    </div>
  </main>
</Layout>
