---
import Layout from "../../layouts/Layout.astro";
import ApiClient from "../../lib/api-client/ApiClient";
import { MapViewer } from "../../components/react/MapViewer";
import { TransportBadge } from "../../components/react/TransportBadge";
import {
  getNSMTransportModes,
  separateMeasures,
  getModalSplitKpiResults,
  createMapMarker,
} from "../../lib/helpers/living-lab";
import { isImplementationKpi } from "../../config/implementationKpis";
import {
  DataDisplayCard,
  LivingLabKPIsView,
  MobilityMeasures,
} from "../../components/react";
import { TriggerDownloadCsv } from "../../components/react/TriggerDownloadCsv/TriggerDownloadCsv";
import type { IKpiResultGroup } from "../../types";
import { displayLabType } from "../../lib/labels";
import { getCityDataStatus, getFullCityStatus } from "../../lib/utils/cityStatus";

const api = new ApiClient(Astro.request);

const { labId } = Astro.params;
if (!labId) {
  return Astro.redirect("/404");
}
const livingLabData = await api.getLivingLab(labId);
if (!livingLabData) {
  return Astro.redirect("/");
}
const allTransportModes = (await api.getTransportModes()) ?? [];
const allKpis = (await api.getKPIs()) ?? [];
const categories = (await api.getCategories("KPI_SIEF")) ?? [];

// Prepare data for components
const nsmTransportModes = getNSMTransportModes(
  livingLabData,
  allTransportModes,
);

// Reconstruct each project with its living_lab_projects_implementation so that
// MobilityMeasures can show lab badges, start dates and implementation details.
// livingLabData.projects strips the implementation off; we rebuild it here from
// the raw implementation join table, injecting the known lab back in.
const measuresWithImpl = (
  livingLabData?.living_lab_projects_implementation ?? []
)
  .filter((impl) => impl.project)
  .map((impl) => ({
    ...impl.project!,
    living_lab_projects_implementation: [{ ...impl, lab: livingLabData }],
  }));

const { pushMeasures, pullMeasures } = separateMeasures(measuresWithImpl);

const modalSplitKpis = getModalSplitKpiResults(
  allKpis,
  allTransportModes,
  (livingLabData?.kpi_results ?? []) as IKpiResultGroup[],
);

const nonModalSplitKpis = allKpis.filter(
  (kpi) => !kpi.kpi_number.startsWith("15"),
);

// T02: split outcome KPIs from implementation-record KPIs
const outcomeKpis = nonModalSplitKpis.filter(
  (kpi) => !isImplementationKpi(kpi.id),
);
const implementationKpis = nonModalSplitKpis.filter((kpi) =>
  isImplementationKpi(kpi.id),
);

const mapMarker = createMapMarker(livingLabData);
const kpiResultsByCategory = categories.map((category) => ({
  ...category,
  kpiResults: (
    livingLabData?.kpi_results as IKpiResultGroup[] | undefined
  )?.filter((kpiResult) =>
    category.kpis?.some((kpi) => kpi.id === kpiResult.kpidefinition_id),
  ),
}));

// T06: determine city data status at SSR time
const cityKpiResults = (livingLabData?.kpi_results as IKpiResultGroup[] | undefined) ?? null;
const cityStatus = getFullCityStatus(Number(livingLabData?.id), cityKpiResults);
const hasData = cityStatus.dataStatus === "has_data";

// Registration date: use created_at if available
const registrationDate = livingLabData?.created_at
  ? new Date(livingLabData.created_at as unknown as string).toLocaleDateString("en-GB", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Living Labs" },
    { label: livingLabData?.name ?? "Living Lab" },
  ]}
  backHref="/"
>
  <div class="lg:mx-10 mx-auto px-1 py-4 flex flex-col gap-8">
    <h2>
      <strong>{livingLabData?.name}</strong> — {displayLabType(Number(livingLabData?.id))} data dashboard
    </h2>

    <!-- Map Section -->
    <section class="flex flex-col lg:flex-row gap-4">
      <div class="h-96 w-full lg:w-3/4 rounded-lg overflow-hidden shadow-md">
        <MapViewer
          center={[mapMarker.coordinates.lat, mapMarker.coordinates.lng]}
          zoom={10}
          markers={[mapMarker]}
          scrollWheelZoom={true}
          client:only="react"
        />
      </div>
      <div class="w-full lg:w-1/4">
        <DataDisplayCard
          data={[
            { label: displayLabType(Number(livingLabData?.id)), value: livingLabData?.name },
            {
              label: "Location",
              //value: `${livingLabData?.city}, ${livingLabData?.country}`,
            },
            {
              label: "Population",
              value: livingLabData?.population,
            },
            {
              label: "Area (km²)",
              value: livingLabData?.area,
            },
            {
              label: "Density (inhabitants/km²)",
              value: livingLabData?.density,
            },
          ]}
        />
      </div>
    </section>

    <div class="flex flex-col gap-8">
      <!-- Transport Modes Section -->
      {
        nsmTransportModes.length > 0 && (
          <div class="flex flex-col gap-4">
            <h3 class="text-center">
              Shared Mobility Services in this Living Lab
            </h3>
            <div class="flex flex-wrap gap-2 mx-auto">
              {nsmTransportModes.map((mode) => (
                <TransportBadge
                  name={mode.name}
                  size="xl"
                  color="secondary"
                  client:load
                />
              ))}
            </div>
          </div>
        )
      }
      <!-- Push & Pull Measures Section -->
      {
        (pushMeasures.length > 0 || pullMeasures.length > 0) && (
          <section class="flex flex-col gap-4">
            <div class="flex flex-col justify-center items-center gap-2">
              <h3>Policy Measures</h3>
              <TriggerDownloadCsv
                type="projects-lab"
                size="md"
                living_lab_id={Number(livingLabData.id)}
                client:load
              />
            </div>
            <MobilityMeasures
              pushMeasures={pushMeasures}
              pullMeasures={pullMeasures}
              hideDescription={false}
              style="card"
              client:load
            />
          </section>
        )
      }
    </div>

    <!-- KPIs Section — T06: data-pending empty state -->
    {
      hasData ? (
        <section class="flex flex-col gap-4">
          <h3 class="text-center">Key Performance Indicators (KPIs)</h3>

          <div class="flex flex-wrap gap-0">
            <LivingLabKPIsView
              modalSplitKpis={modalSplitKpis}
              living_lab_id={Number(livingLabData.id)}
              client:load
            />
          </div>

          <div class="flex flex-wrap gap-0">
            <LivingLabKPIsView
              categories={kpiResultsByCategory ?? []}
              kpis={outcomeKpis}
              implementationKpis={implementationKpis}
              lab_validated_at={livingLabData?.validated_at ?? null}
              living_lab_id={Number(livingLabData.id)}
              client:load
            />
          </div>
        </section>
      ) : (
        <section class="flex flex-col gap-4">
          <h3 class="text-center">Key Performance Indicators (KPIs)</h3>
          <div class="bg-blue-50 border border-blue-200 rounded-xl p-8 flex flex-col gap-4 max-w-2xl mx-auto w-full">
            <div class="flex items-center gap-3">
              <div class="flex flex-col gap-1">
                <h4 class="font-bold text-gray-900">{livingLabData?.name}</h4>
                <div class="flex gap-2 flex-wrap">
                  <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary">
                    {cityStatus.typeLabel}
                  </span>
                  <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium bg-warning/10 text-warning">
                    {cityStatus.statusLabel}
                  </span>
                </div>
              </div>
            </div>

            {registrationDate && (
              <p class="text-sm text-gray-600">
                Registered on: <span class="font-medium">{registrationDate}</span>
              </p>
            )}

            <div class="bg-white rounded-lg border border-blue-200 p-4">
              <p class="text-gray-700 font-medium">
                Registered (no data yet)
              </p>
              <p class="text-sm text-gray-500 mt-1">
                This city has been registered on the SUM Open Data Platform but
                has not yet published KPI data. Data will appear here once the
                city team submits their baseline and follow-up measurements.
              </p>
            </div>
          </div>
        </section>
      )
    }
  </div>
</Layout>
