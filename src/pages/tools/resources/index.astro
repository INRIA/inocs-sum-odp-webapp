---
import Layout from "../../../layouts/Layout.astro";
import ApiClient from "../../../lib/api-client/ApiClient";
import { ResourcesDashboard } from "../../../components/react/ResourcesDashboard";
import type {
  IResource,
  IResourceCategory,
} from "../../../components/react/ResourcesDashboard";
import { truncateHtml } from "../../../lib/helpers";

const api = new ApiClient(Astro.request);

const resources = await api.getItemsByCategoryType("RESOURCES");

const categoryMap = new Map<number, IResourceCategory>();
resources?.forEach((resource) => {
  if (!categoryMap.has(resource.category_id)) {
    categoryMap.set(resource.category_id, {
      id: resource.category_id,
      name: resource.category.name,
      resources: [],
    });
  }
  categoryMap.get(resource.category_id)!.resources.push({
    ...resource,
    description: truncateHtml(resource.description ?? "", 200),
  });
});
const categories = Array.from(categoryMap.values());
---

<Layout>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <section class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-gray-900">Innovation Resources</h1>
      <p class="mt-4 text-lg text-gray-600">
        Discover research papers, datasets, and tools for sustainable urban
        mobility.
      </p>
    </section>

    <ResourcesDashboard categories={categories} client:load />
  </main>
</Layout>
